# Servidor Next.js de la API. En local, npm run dev en backend usa el puerto 6001.
API_BASE_URL=http://localhost:6001

# Optional: HTML verification tokens only (never a Google password/API credential).
# Domain verification using a DNS TXT record does not need these variables.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Proveedor de mapa; mantener la atribución correspondiente si se cambia.
NEXT_PUBLIC_EVENT_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_EVENT_MAP_ATTRIBUTION=© OpenStreetMap contributors
